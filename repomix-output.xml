@import "tailwindcss";

:root {
  color-scheme: dark;
}

body {
  background-color: #07110f;
  color: #dce8df;
}

button,
input {
  font: inherit;
}

.triply-stop-marker,
.triply-parking-marker {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
}

.triply-stop-marker span {
  display: block;
  width: 14px;
  height: 14px;
  border: 3px solid #040814;
  border-radius: 999px;
  box-shadow: 0 0 0 3px rgb(255 255 255 / 75%), 0 2px 10px rgb(0 0 0 / 45%);
}

.triply-marker-selected {
  z-index: 1000 !important;
  filter: drop-shadow(0 0 9px rgb(255 255 255 / 95%));
}

.triply-marker-selected.triply-stop-marker span {
  width: 22px;
  height: 22px;
  border-width: 4px;
  box-shadow: 0 0 0 4px #fff, 0 0 18px rgb(34 211 238 / 90%);
}

.triply-parking-marker span {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border: 3px solid #fff7ed;
  border-radius: 999px;
  background: #f97316 !important;
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  box-shadow: 0 2px 12px rgb(15 23 42 / 60%);
}

.triply-marker-selected.triply-parking-marker span {
  width: 42px;
  height: 42px;
  border-width: 4px;
  background: #ea580c !important;
  box-shadow: 0 0 0 4px #fff, 0 0 22px rgb(249 115 22 / 95%);
  font-size: 24px;
}
